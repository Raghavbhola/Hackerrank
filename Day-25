# Enter your code here. Read input from STDIN. Print output to STDOUT
T = int(input())
while T > 0:
    n = int(input())
    if n <= 1:
        print("Not Prime")
    else:
        is_prime = True
        for i in range(2,n):
            if n % i == 0:
                is_prime = False
                break
        
        if is_prime:
            print("Prime")
        else:
            print("Not prime")  
    T -= 1                   
    
