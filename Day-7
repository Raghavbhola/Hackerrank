# Enter your code here. Read input from STDIN. Print output to STDOUT
t = int(input())   # number of test cases

for _ in range(t):
    s = input().strip()
    even_chars = ""
    odd_chars = ""
    
    for index, ch in enumerate(s):
        if index % 2 == 0:
            even_chars += ch
        else:
            odd_chars += ch
    
    print(even_chars, odd_chars)
